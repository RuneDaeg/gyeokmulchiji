{
  "name": "gyeokmulchiji-desktop",
  "productName": "격물치지",
  "version": "1.0.0",
  "description": "격물치지 — 수학·과학·인문 그림 편집기 (윈도우 앱)",
  "author": "McKay",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "app": "electron .",
    "dist:win": "node build-desktop.mjs && electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "kr.mathmckay.gyeokmulchiji",
    "productName": "격물치지",
    "executableName": "Gyeokmulchiji",
    "copyright": "McKay",
    "directories": { "output": "C:/dev/gyeokmulchiji-release", "buildResources": "build" },
    "files": ["electron/**", "app/**", "build/icon.png", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "격물치지",
      "artifactName": "Gyeokmulchiji-Setup.${ext}",
      "installerLanguages": ["ko_KR"],
      "language": "1042"
    },
    "portable": { "artifactName": "Gyeokmulchiji-Portable.${ext}" },
    "mac": { "target": [{ "target": "zip", "arch": ["arm64", "x64"] }], "icon": "build/icon.png", "category": "public.app-category.education", "identity": null, "artifactName": "Gyeokmulchiji-Mac-${arch}.${ext}" },
    "dmg": { "title": "격물치지 ${version}" },
    "publish": [{ "provider": "generic", "url": "https://draw.mathmckay.kr/download" }]
  }
}
